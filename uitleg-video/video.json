      "cursor": {
        "path": [[0.6, 620, 560], [1.4, "blikje-plus"], [2.6, "blikje-plus"], [3.4, "ei-plus"], [4.2, "ei-plus"], [6.1, 760, 470], [6.8, "registreer"], [7.6, "registreer"]],
        "clicks": [1.6, 2.3, 3.5, 7.0],
        "visible": [[0.6, 4.4], [6.0, 7.8]]
      }
    },
    {
      "title": ["SLIMME", "KOELKAST"],
      "duration": 13,
      "still": 7.6,
      "about": "Koelkastscherm: eerst 'Koelkast openen' met een dichte koelkast. De pas schuift naar de lezer, het slot gaat open: 'De deur is open'. Twee blikjes verdwijnen van schap 1 en 'In je hand' telt mee. Na 'Deur dicht' een groene bevestiging dat het is geregistreerd.",
      "steps": [
        { "at": 0.6, "text": "Houd je pas tegen de koelkast. Hij gaat open." },
        { "at": 5.4, "text": "Wat je pakt, telt de koelkast zelf." }
      ],
      "screen": "koelkast",
      "timeline": [
        { "at": 2.5, "hide": ["kop-dicht", "kk-dicht"] },
        { "at": 2.5, "show": ["kop-open", "hand"] },
        { "at": 2.5, "until": 6.2, "show": "kk-open" },
        { "at": 6.2, "until": 7.0, "show": "kk-1" },
        { "at": 7.0, "show": "kk-2" },
        { "at": 6.2, "set": "in-hand", "text": "1× Blikje" },
        { "at": 7.0, "set": "in-hand", "text": "2× Blikje" },
        { "at": 6.2, "until": 7.6, "flash": "hand" },
        { "at": 0, "until": 2.5, "disable": "deur" },
        { "at": 9.6, "hide": "venster" },
        { "at": 9.6, "show": "geregistreerd" },
        { "animate": "pas", "keys": [[1.1, { "o": 0, "x": 160, "y": 80 }], [2.1, { "o": 1, "x": -40, "y": -20 }, "out"], [2.6, { "o": 1, "x": -40, "y": -20 }], [3.0, { "o": 0, "x": 60, "y": 40 }]] }
      ],
      "cursor": {
        "path": [[7.9, 760, 420], [8.9, "deur"], [9.9, "deur"]],
        "clicks": [9.3],
        "visible": [[7.9, 10.2]]
      }
    },
    {
      "title": ["OVERZICHT", "VOOR BEHEER"],
      "duration": 13,
      "still": 9.0,
      "about": "Beheerscherm, tabblad Registraties: tabel met medewerker, product, aantal en datum. Maand 'Oktober 2026' kiezen, de rijen uit september verdwijnen. Daarna 'CSV exporteren' en de melding van de browser dat het bestand klaarstaat.",
      "steps": [
        { "at": 0.6, "text": "Beheer ziet alles per medewerker en maand." },
        { "at": 5.6, "text": "Zet het overzicht klaar voor de loonadministratie." }
      ],
      "screen": "beheer",
      "timeline": [
        { "at": 1.9, "until": 3.0, "show": "maand-menu" },
        { "at": 3.0, "set": "maand-value", "text": "Oktober 2026" },
        { "at": 3.3, "hide": ["rij-6", "rij-7"] },
        { "at": 7.3, "set": "export-label", "text": "Exporteren…" },
        { "at": 7.8, "set": "export-label", "text": "CSV exporteren" },
        { "animate": "download", "keys": [[7.8, { "o": 0, "y": -10 }], [8.1, { "o": 1, "y": 0 }, "out"], [11.6, { "o": 1, "y": 0 }], [12.0, { "o": 0, "y": 0 }]] }
      ],
      "cursor": {
        "path": [[0.8, 700, 520], [1.6, "maand"], [2.1, "maand"], [2.6, "maand-opt-1"], [3.2, "maand-opt-1"], [4.0, 700, 430], [6.0, 700, 430], [6.9, "export"], [8.2, "export"]],
        "clicks": [1.8, 2.9, 7.1],
        "visible": [[0.8, 4.2], [6.0, 8.4]]
      }
