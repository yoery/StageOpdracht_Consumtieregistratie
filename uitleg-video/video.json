  "scenes": [
    {
      "title": ["JEZELF", "AANMELDEN"],
      "duration": 13,
      "still": 3.4,
      "about": "Startscherm van de tablet: ovaal met 'Kijk in het ovaal' en 'Of houd je pas tegen de lezer'. Een pas schuift naar de lezer, het ovaal wordt groen en de app groet: 'Goedemiddag Fleur.' Daarna staat er een getekend gezicht in het ovaal: 'Even stil blijven…' en weer de begroeting.",
      "steps": [
        { "at": 0.6, "text": "Houd je pas tegen de lezer." },
        { "at": 5.5, "text": "Of kijk in de camera. De app herkent je." }
      ],
      "screen": "start",
      "timeline": [
        { "at": 2.5, "until": 4.9, "show": "start-pas" },
        { "at": 6.4, "until": 8.0, "show": "start-gezicht" },
        { "at": 8.0, "show": "start-herkend" },
        { "animate": "pas", "keys": [[1.1, { "o": 0, "x": 160, "y": 80 }], [2.1, { "o": 1, "x": -40, "y": -20 }, "out"], [2.7, { "o": 1, "x": -40, "y": -20 }], [3.1, { "o": 0, "x": 60, "y": 40 }]] }
      ]
    },
    {
      "title": ["CONSUMPTIE", "REGISTREREN"],
      "duration": 13,
      "still": 5.0,
      "about": "Productvenster van Fleur Kok: vijf producten met een min- en plusknop. Twee keer plus bij Blikje, één keer bij Ei; de knop wordt 'Registreren (3)'. Na de tik verschijnt een groene bevestiging.",
      "steps": [
        { "at": 0.6, "text": "Tik op + bij wat je pakt." },
        { "at": 5.6, "text": "Tik op Registreren. Klaar." }
      ],
      "screen": "producten",
      "timeline": [
        { "at": 1.7, "set": "blikje-count", "text": "1" },
        { "at": 2.4, "set": "blikje-count", "text": "2" },
        { "at": 3.6, "set": "ei-count", "text": "1" },
        { "at": 1.7, "show": "blikje-on" },
        { "at": 3.6, "show": "ei-on" },
        { "at": 1.7, "set": "registreer", "text": "Registreren (1)" },
        { "at": 2.4, "set": "registreer", "text": "Registreren (2)" },
        { "at": 3.6, "set": "registreer", "text": "Registreren (3)" },
        { "at": 0, "until": 1.7, "disable": "registreer" },
        { "at": 7.3, "hide": "kiezen" },
        { "at": 7.3, "show": "klaar" }
