<table>
<tr><th>Code</th><th>Heuristiek</th></tr>
<tr><td>H1</td><td>Zichtbaarheid van de systeemstatus</td></tr>
<tr><td>H2</td><td>Overeenkomst tussen het systeem en de echte wereld</td></tr>
<tr><td>H3</td><td>Gebruikerscontrole en vrijheid</td></tr>
<tr><td>H4</td><td>Consistentie en standaarden</td></tr>
<tr><td>H5</td><td>Foutpreventie</td></tr>
<tr><td>H6</td><td>Herkennen in plaats van herinneren</td></tr>
<tr><td>H7</td><td>Flexibiliteit en efficiëntie</td></tr>
<tr><td>H8</td><td>Esthetisch en minimalistisch ontwerp</td></tr>
<tr><td>H9</td><td>Gebruikers helpen fouten te herkennen, begrijpen en herstellen</td></tr>
<tr><td>H10</td><td>Hulp en documentatie</td></tr>
</table>
